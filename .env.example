# ==============================================================================
# WebQLBH Environment Configuration Template (.env.example)
# Sao chep file nay thanh .env va thiet lap cac gia tri bi mat thuc te truoc khi chay
# ==============================================================================

# Moi truong chay ASP.NET Core: Production hoac Development
ASPNETCORE_ENVIRONMENT=Production

# Mat khau quan tri SQL Server (tai khoan sa) - Yeu cau chuoi phuc tap
MSSQL_SA_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD

# Cong host bind SQL Server (chi bind localhost de bao mat)
SQL_HOST_PORT=14333

# Cong host bind Web Application
WEB_HOST_PORT=8080

# Thong tin dang nhap Quan tri vien Web (Admin)
ADMIN_USERNAME=admin

# Ma hash mat khau sinh boi IPasswordHasher cua ASP.NET Core Identity
ADMIN_PASSWORD_HASH=CHANGE_ME_TO_A_VALID_PASSWORD_HASH
