# ==============================================================================
# WebQLBH Environment Configuration Template (.env.example)
# Copy file nay thanh .env de cau hinh bien moi truong cho he thong
# ==============================================================================

# Moi truong chay ASP.NET Core: Production hoac Development
ASPNETCORE_ENVIRONMENT=Production

# Mat khau quan tri SQL Server (tai khoan sa)
MSSQL_SA_PASSWORD=YourStrong@Password123!

# Cong host bind SQL Server (chi bind localhost de bao mat)
SQL_HOST_PORT=14333

# Cong host bind Web Application
WEB_HOST_PORT=8080

# Thong tin dang nhap Quan tri vien Web (Admin)
ADMIN_USERNAME=admin
# Hash mat khau su dung IPasswordHasher cua ASP.NET Core Identity
ADMIN_PASSWORD_HASH=AQAAAAEAACcQAAAAEBSiF1LsxocmGshIPeSaQ+6gIXxu9QE3CnLtG+2IhgW4PF7FFOwryhn7BMeCMx6VVA==
