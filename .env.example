# ==============================================================================
# WebQLBH Environment Configuration Template (.env.example)
# Sao chép tệp này thành .env để khởi chạy hệ thống:
#   cp .env.example .env
#   docker compose up -d
# ==============================================================================

# Môi trường chạy ASP.NET Core: Production hoặc Development
ASPNETCORE_ENVIRONMENT=Production

# Cấu hình SQL Server (tài khoản sa)
# Giá trị mặc định dùng cho môi trường Demo/Kiểm thử cục bộ:
MSSQL_SA_PASSWORD=Password@123

# Cổng host ánh xạ (Port mapping)
SQL_HOST_PORT=14333
WEB_HOST_PORT=8080

# Tài khoản Quản trị viên Web (Admin)
ADMIN_USERNAME=admin

# Mã băm mật khẩu (PBKDF2 HMAC-SHA256) chuẩn ASP.NET Core Identity
# Dưới đây là mã băm sẵn cho mật khẩu kiểm thử: Admin@2026!Secure
ADMIN_PASSWORD_HASH=AQAAAAEAACcQAAAAEBSiF1LsxocmGshIPeSaQ+6gIXxu9QE3CnLtG+2IhgW4PF7FFOwryhn7BMeCMx6VVA==

# ------------------------------------------------------------------------------
# [LƯU Ý BẢO MẬT PRODUCTION]
# Khi triển khai thực tế trên môi trường Internet/Production:
# 1. Thay đổi MSSQL_SA_PASSWORD thành mật khẩu phức tạp ngẫu nhiên.
# 2. Để sinh mã băm mật khẩu mới cho quản trị viên, chạy lệnh C# nhanh:
#    var hasher = new Microsoft.AspNetCore.Identity.PasswordHasher<string>();
#    string newHash = hasher.HashPassword("admin", "MatKhauMoiCuaBan");
# ------------------------------------------------------------------------------
