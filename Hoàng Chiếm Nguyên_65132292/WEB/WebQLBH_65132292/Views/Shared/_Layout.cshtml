@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var pageTitle = ViewData["Title"]?.ToString() ?? controller;
    var currentUserName = User.Identity?.IsAuthenticated == true
        ? (User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Admin")
        : "Khach";
    var userInitial = string.IsNullOrWhiteSpace(currentUserName)
        ? "A"
        : currentUserName.Trim().Substring(0, 1).ToUpperInvariant();

    var crudControllers = new[] { "NhomSPs", "LoaiSPs", "SanPhams", "KhachHangs", "NhaCCs", "DonMHs", "DonBHs" };
    var crudActions = new[] { "Create", "Edit", "Details", "Delete" };

    var isCrudShell = Array.Exists(crudControllers, name => string.Equals(name, controller,
StringComparison.OrdinalIgnoreCase))
        && Array.Exists(crudActions, name => string.Equals(name, action, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@pageTitle - QL Bán Hàng</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700;800&family=Space+Mono:wght@400;700&display=swap"
    rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>

<body>
    <div class="app-layout">
        <aside class="app-sidebar">
            <a class="sidebar-brand" asp-area="" asp-controller="Home" asp-action="Index" title="Trang chủ">
                <span class="sidebar-brand-mark" aria-hidden="true"><i class="bi bi-grid-1x2-fill"></i></span>
                <span class="sidebar-brand-text">
                    <span class="sidebar-brand-name">QL Bán Hàng</span>
                    <span class="sidebar-brand-sub">WebQLBH_65132292</span>
                </span>
            </a>

            <div class="sidebar-scroll">
                <div class="nav-group">
                    <p class="nav-group-label">DANH MỤC</p>
                    <ul class="sidebar-nav">
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="Home" asp-action="Index" title="Trang chủ">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-house-door"></i></span>
                                <span class="nav-item-label">Trang chủ</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="nav-group">
                    <p class="nav-group-label">HÀNG HÓA</p>
                    <ul class="sidebar-nav">
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhomSPs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="NhomSPs" asp-action="Index" title="Nhóm SP">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-boxes"></i></span>
                                <span class="nav-item-label">Nhóm SP</span>
                            </a>
                        </li>
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "LoaiSPs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="LoaiSPs" asp-action="Index" title="Loại SP">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-tags"></i></span>
                                <span class="nav-item-label">Loại SP</span>
                            </a>
                        </li>
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "SanPhams" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="SanPhams" asp-action="Index" title="Sản phẩm">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-bag"></i></span>
                                <span class="nav-item-label">Sản phẩm</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="nav-group">
                    <p class="nav-group-label">ĐỐI TÁC</p>
                    <ul class="sidebar-nav">
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "KhachHangs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="KhachHangs" asp-action="Index" title="Khách hàng">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-people"></i></span>
                                <span class="nav-item-label">Khách hàng</span>
                            </a>
                        </li>
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "NhaCCs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="NhaCCs" asp-action="Index" title="Nhà cung cấp">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-building"></i></span>
                                <span class="nav-item-label">Nhà cung cấp</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="nav-group">
                    <p class="nav-group-label">GIAO DỊCH</p>
                    <ul class="sidebar-nav">
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DonMHs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="DonMHs" asp-action="Index" title="Đơn mua">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-cart3"></i></span>
                                <span class="nav-item-label">Đơn mua</span>
                            </a>
                        </li>
                        <li
                            class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "DonBHs" ? "active" : "")">
                            <a class="nav-item-link" asp-controller="DonBHs" asp-action="Index" title="Đơn bán">
                                <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-receipt"></i></span>
                                <span class="nav-item-label">Đơn bán</span>
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="nav-group">
                    <p class="nav-group-label">PHÂN TÍCH</p>
                    <ul class="sidebar-nav">
                        <li
                            class="nav-item @((ViewContext.RouteData.Values["controller"]?.ToString() == "BaoCao" || ViewContext.RouteData.Values["controller"]?.ToString() == "BaoCaos") ? "active" : "")">
                            <a class="nav-item-link" asp-controller="BaoCao" asp-action="Index" title="Báo cáo">
                                <span class="nav-item-icon" aria-hidden="true"><i
                                    class="bi bi-bar-chart-line"></i></span>
                                    <span class="nav-item-label">Báo cáo</span>
                                </a>
                            </li>
                            <li
                                class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "TraCuu" ? "active" : "")">
                                <a class="nav-item-link" asp-controller="TraCuu" asp-action="SanPham" title="Tra cứu">
                                    <span class="nav-item-icon" aria-hidden="true"><i class="bi bi-search"></i></span>
                                    <span class="nav-item-label">Tra cứu</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="sidebar-footer">
                    <div class="sidebar-user">
                        <span class="sidebar-avatar">@userInitial</span>
                        <div class="sidebar-user-meta">
                            <span class="sidebar-user-name">@currentUserName</span>
                            <span class="sidebar-user-role">Quản trị hệ thống</span>
                        </div>
                    </div>
                    <button type="button" class="sidebar-toggle-btn" data-sidebar-toggle title="Thu gọn sidebar"
                            aria-label="Thu gọn sidebar">◀</button>
                </div>
            </aside>

            <button type="button" class="sidebar-overlay" data-sidebar-overlay aria-label="Đóng menu"></button>

            <div class="app-main">
                <header class="app-topbar">
                    <div class="topbar-left">
                        <button type="button" class="sidebar-mobile-toggle" data-sidebar-mobile-toggle
                                aria-label="Mở menu">☰</button>
                        <nav class="topbar-breadcrumb" aria-label="breadcrumb">
                            <span class="root">Trang chủ</span>
                            <span class="sep">/</span>
                            <span class="current">@pageTitle</span>
                        </nav>
                    </div>
                    <div class="topbar-right">
                        <button type="button" class="topbar-icon-btn" title="Thông báo" aria-label="Thông báo"><i
                            class="bi bi-bell"></i></button>
                            <div class="user-dropdown">
                                <button type="button" class="user-dropdown-btn" aria-label="Tài khoản">
                                    <span class="user-dot">@userInitial</span>
                                    <span class="user-name">@currentUserName</span>
                                    <span class="user-caret">▾</span>
                                </button>
                                <div class="user-dropdown-menu">
                                    <a asp-controller="Home" asp-action="Index">Ho so</a>
                                    <a asp-controller="Home" asp-action="Privacy">Cai dat</a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="user-logout-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="user-logout-btn">Dang xuat</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </header>

                    <main class="app-content">
                        <div class="page-shell @(isCrudShell ? "crud-shell" : string.Empty)">
                            @if (TempData["WorkflowError"] is string workflowError)
                            {
                                <div class="workflow-alert workflow-alert-warning" role="alert">@workflowError</div>
                            }

                            @if (TempData["WorkflowWarning"] is string workflowWarning)
                            {
                                <div class="workflow-alert workflow-alert-warning" role="alert">@workflowWarning</div>
                            }

                            @if (TempData["WorkflowSuccess"] is string workflowSuccess)
                            {
                                <div class="workflow-alert workflow-alert-success" role="alert">@workflowSuccess</div>
                            }

                            @RenderBody()
                        </div>
                    </main>
                </div>
            </div>

            <script src="~/lib/jquery/dist/jquery.min.js"></script>
            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
            <script src="~/js/site.js" asp-append-version="true"></script>
            <script src="~/js/sidebar.js" asp-append-version="true"></script>
            @await RenderSectionAsync("Scripts", required: false)
        </body>

    </html>
