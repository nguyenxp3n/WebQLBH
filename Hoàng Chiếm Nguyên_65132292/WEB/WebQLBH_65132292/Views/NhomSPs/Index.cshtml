@model IEnumerable<DbQLBH_65132292.Models.NhomSP>

@{
    ViewData["Title"] = "Nhóm sản phẩm";
    var items = Model?.ToList() ?? new List<DbQLBH_65132292.Models.NhomSP>();
    var stt = 1;
}

<section class="inventory-page list-page">
    <div class="inventory-header page-header page-header-split">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title page-title">Quản lý Nhóm sản phẩm</h1>
            <p class="inventory-subtitle page-subtitle">Đồng bộ danh mục nhóm sản phẩm theo giao diện quản trị thống nhất.</p>
            </div>
            <div class="inventory-toolbar">
                <a asp-action="Create" class="inventory-add-btn">Thêm nhóm mới</a>
            </div>
        </div>

        <div class="inventory-card inventory-filter-card search-card mb-4">
            <label class="form-label" for="nhomSpSearch">Tìm kiếm</label>
            <div class="inventory-search-wrap">
                <i class="bi bi-search inventory-search-icon" aria-hidden="true"></i>
                <input id="nhomSpSearch" class="inventory-search" type="search" aria-label="Tìm mã hoặc tên nhóm"
                       placeholder="Tìm theo mã nhóm hoặc tên nhóm sản phẩm..." />
            </div>
        </div>

        <div class="inventory-card">
            <div class="inventory-table-wrap table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th style="width: 90px;">STT</th>
                            <th style="width: 140px;">Mã nhóm</th>
                            <th>Tên nhóm sản phẩm</th>
                            <th style="width: 140px;">Trạng thái</th>
                            <th style="width: 240px; text-align: right;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted">Không có dữ liệu để hiển thị.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in items)
                            {
                                <tr data-search-row="@($"{item.MaNSP} {item.TenNSP}")">
                                    <td>@stt</td>
                                    <td><span class="inventory-code">@item.MaNSP</span></td>
                                    <td><span class="inventory-name">@item.TenNSP</span></td>
                                    <td><span class="status-badge status-success">Hoạt động</span></td>
                                    <td class="text-end">
                                        <div class="inventory-actions">
                                            <a asp-action="Details" asp-route-id="@item.MaNSP" class="inventory-action">Chi tiết</a>
                                            <a asp-action="Edit" asp-route-id="@item.MaNSP" class="inventory-action">Sửa</a>
                                            <a asp-action="Delete" asp-route-id="@item.MaNSP"
                                               class="inventory-action delete">Xóa</a>
                                        </div>
                                    </td>
                                </tr>
                                stt++;
                            }
                            <tr class="inventory-empty-row" data-empty-row hidden>
                                <td colspan="5">
                                    <p class="inventory-empty-message" data-empty-message>Không có dữ liệu để hiển thị.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="inventory-footer">
                <p class="inventory-stats">Tổng số <strong>@items.Count</strong> nhóm sản phẩm</p>
            </div>
        </div>
    </section>

    @section Scripts {
        <script>
            (function () {
                const input = document.getElementById("nhomSpSearch");
                if (!input) {
                    return;
                }

                const rows = Array.from(document.querySelectorAll("tr[data-search-row]"));
                const emptyRow = document.querySelector("tr[data-empty-row]");

                function normalize(value) {
                    return (value || "").toLowerCase().trim();
                }

                function applyFilter() {
                    const keyword = normalize(input.value);
                    let visibleCount = 0;

                    rows.forEach(row => {
                        const text = normalize(row.getAttribute("data-search-row"));
                        const visible = !keyword || text.includes(keyword);
                        row.hidden = !visible;
                        if (visible) {
                            visibleCount += 1;
                        }
                    });

                    if (emptyRow) {
                        emptyRow.hidden = visibleCount > 0;
                    }
                }

                input.addEventListener("input", applyFilter);
            })();
        </script>
    }
