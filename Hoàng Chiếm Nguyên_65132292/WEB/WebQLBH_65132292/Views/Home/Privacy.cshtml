@{
    ViewData["Title"] = "Cài đặt & Hồ sơ";
}

<section class="inventory-page settings-page">
    <div class="inventory-header page-header page-header-split mb-4">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title page-title h4 mb-1">Cài đặt hệ thống & Hồ sơ cá nhân</h1>
            <p class="inventory-subtitle page-subtitle text-muted mb-0">Quản lý thông tin quản trị viên, cấu hình bảo mật và tùy biến trải nghiệm người dùng.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="inventory-card p-4 h-100 settings-profile-card">
                <div class="text-center mb-3">
                    <div class="sidebar-avatar mx-auto mb-2" style="width: 58px; height: 58px; font-size: 24px; background: linear-gradient(135deg, #10B981, #059669); border-radius: 14px;">A</div>
                    <h2 class="h5 mb-0 fw-bold text-dark">Quản trị viên</h2>
                    <span class="badge-status badge-done mt-2"><span class="badge-dot badge-pulse"></span> Quản trị hệ thống</span>
                </div>

                <dl class="row mb-0 detail-meta-list compact small border-top pt-3">
                    <dt class="col-5 text-muted">Hộp thư</dt>
                    <dd class="col-7 font-monospace">admin@qlbanhang.vn</dd>
                    <dt class="col-5 text-muted">Điện thoại</dt>
                    <dd class="col-7 font-monospace">0900 000 000</dd>
                    <dt class="col-5 text-muted">Vai trò</dt>
                    <dd class="col-7 font-weight-bold text-dark">Super Admin</dd>
                </dl>

                <button type="button" class="btn btn-primary w-100 mt-4">
                    <i class="bi bi-person-check me-1"></i> Cập nhật hồ sơ
                </button>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="inventory-card p-4 mb-4">
                <h2 class="h5 mb-3 fw-bold text-dark"><i class="bi bi-shield-lock me-2" style="color: var(--accent-emerald);"></i>Bảo mật tài khoản</h2>
                <div class="row g-3 admin-form-grid">
                    <div class="col-12 col-md-6">
                        <label class="control-label small text-muted mb-1">Mật khẩu hiện tại</label>
                        <input class="form-control font-monospace" type="password" value="****************" readonly />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="control-label small text-muted mb-1">Xác thực hai lớp (2FA)</label>
                        <select class="form-select">
                            <option>Đã bật (Bảo vệ nâng cao)</option>
                            <option>Tạm tắt</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="inventory-card p-4">
                <h2 class="h5 mb-3 fw-bold text-dark"><i class="bi bi-sliders me-2" style="color: var(--accent-emerald);"></i>Tùy chỉnh giao diện</h2>
                <div class="settings-toggle-list d-flex flex-column gap-3">
                    <label class="form-check d-flex align-items-center gap-2 mb-0">
                        <input class="form-check-input" type="checkbox" checked />
                        <span class="text-dark">Hiển thị thông báo theo thời gian thực (SignalR Pulse)</span>
                    </label>
                    <label class="form-check d-flex align-items-center gap-2 mb-0">
                        <input class="form-check-input" type="checkbox" checked />
                        <span class="text-dark">Hiển thị biểu đồ doanh thu 7 ngày trên trang chủ</span>
                    </label>
                    <label class="form-check d-flex align-items-center gap-2 mb-0">
                        <input class="form-check-input" type="checkbox" checked />
                        <span class="text-dark">Tự động thu gọn thanh điều hướng trên màn hình nhỏ</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</section>
