@model DbQLBH_65132292.Models.DonMH

@{
    ViewData["Title"] = "Sửa đơn mua";
}

<h1 class="page-title">Sửa đơn mua</h1>
<hr />
<div class="row">
    <div class="col-md-6 col-lg-5">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDMH" />
            <div class="mb-3">
                <label asp-for="NgayMua" class="form-label"></label>
                <input asp-for="NgayMua" type="date" class="form-control" />
                <span asp-validation-for="NgayMua" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MaNCC" class="form-label">Nhà cung cấp</label>
                <select asp-for="MaNCC" class="form-select" asp-items="ViewBag.NhaCCOptions">
                    <option value="">-- Chọn nhà cung cấp --</option>
                </select>
                <span asp-validation-for="MaNCC" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Details" asp-route-id="@Model.MaDMH" class="btn btn-outline-secondary ms-2">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
