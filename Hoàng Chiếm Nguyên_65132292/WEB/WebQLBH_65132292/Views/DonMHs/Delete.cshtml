@model DbQLBH_65132292.Models.DonMH

@{
    ViewData["Title"] = "Xóa đơn mua";
}

<h1 class="page-title h4 mb-1">Xóa đơn mua hàng</h1>
<h3>Bạn có chắc chắn muốn xóa đơn mua hàng @Model.MaDMH?</h3>

<div>
    <dl class="row">
        <dt class="col-sm-3">Ngày mua</dt>
        <dd class="col-sm-9">@Model.NgayMua.ToString("dd/MM/yyyy")</dd>
        <dt class="col-sm-3">Mã NCC</dt>
        <dd class="col-sm-9">@Model.MaNCC</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaDMH" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
    </form>
</div>
