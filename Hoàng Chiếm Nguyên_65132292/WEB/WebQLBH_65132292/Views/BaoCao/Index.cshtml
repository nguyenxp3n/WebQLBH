@model DbQLBH_65132292.Models.BaoCaoTongQuanViewModel

@{
    ViewData["Title"] = "Báo cáo tổng quan";
}

<section class="inventory-page bao-cao-page">
    <div class="inventory-header d-flex justify-content-between align-items-center mb-4">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title h4 mb-1">Báo cáo tổng quan danh mục</h1>
            <p class="inventory-subtitle text-muted mb-0">Thống kê danh mục sản phẩm và các chỉ số giá trị từ dữ liệu hệ thống.</p>
        </div>
        <div class="inventory-toolbar">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-clockwise me-1"></i> Làm mới dữ liệu
            </a>
        </div>
    </div>

    <!-- KPI Metric Bento Grid -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-xl-3">
            <article class="kpi-card kpi-card-products p-3">
                <p class="kpi-label mb-1">Tổng nhóm sản phẩm</p>
                <p class="kpi-value mb-0">@Model.TongNhomSP</p>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="kpi-card kpi-card-partners p-3">
                <p class="kpi-label mb-1">Tổng loại sản phẩm</p>
                <p class="kpi-value mb-0">@Model.TongLoaiSP</p>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="kpi-card kpi-card-orders p-3">
                <p class="kpi-label mb-1">Tổng số sản phẩm</p>
                <p class="kpi-value mb-0">@Model.TongSanPham</p>
            </article>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <article class="kpi-card kpi-card-revenue p-3">
                <p class="kpi-label mb-1">Đơn giá trung bình</p>
                <p class="kpi-value mb-0" style="color: var(--accent-emerald);">@Model.GiaTrungBinh.ToString("N0") <small class="fs-6 text-muted">VNĐ</small></p>
            </article>
        </div>
    </div>

    <!-- Category Breakdown & Top Value Products -->
    <div class="row g-4">
        <div class="col-12 col-xl-7">
            <div class="inventory-card">
                <div class="p-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="h5 mb-0 fw-bold text-dark">Thống kê theo nhóm sản phẩm</h2>
                        <p class="text-muted small mb-0">Số loại và số sản phẩm trực thuộc từng nhóm hàng</p>
                    </div>
                    <span class="badge-status badge-new">@Model.NhomThongKe.Count nhóm</span>
                </div>
                <div class="inventory-table-wrap table-responsive">
                    <table class="inventory-table table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 130px;">Mã NSP</th>
                                <th>Tên nhóm sản phẩm</th>
                                <th style="width: 140px;" class="text-center">Số loại SP</th>
                                <th style="width: 150px;" class="text-center">Số sản phẩm</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.NhomThongKe.Count == 0)
                            {
                                <tr>
                                    <td colspan="4">
                                        <div class="empty-state-card my-3 py-4">
                                            <i class="bi bi-boxes empty-state-icon mb-2"></i>
                                            <p class="empty-state-title mb-1">Chưa có dữ liệu nhóm sản phẩm</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in Model.NhomThongKe)
                                {
                                    <tr>
                                        <td><span class="code-badge">@item.MaNSP</span></td>
                                        <td class="fw-semibold text-dark">@item.TenNSP</td>
                                        <td class="text-center"><span class="badge-status badge-new font-monospace">@item.SoLoaiSP</span></td>
                                        <td class="text-center"><span class="badge-status badge-done font-monospace">@item.SoSanPham</span></td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-5">
            <div class="inventory-card p-3">
                <div class="border-bottom pb-3 mb-3">
                    <h2 class="h5 mb-0 fw-bold text-dark">Top 5 sản phẩm giá cao nhất</h2>
                    <p class="text-muted small mb-0">Xếp hạng theo đơn giá niêm yết giảm dần</p>
                </div>

                <div class="d-flex justify-content-between bg-light p-3 rounded mb-3 border">
                    <div>
                        <span class="text-muted small d-block">Đơn giá thấp nhất</span>
                        <span class="fw-bold text-dark font-monospace">@Model.GiaThapNhat.ToString("N0") VNĐ</span>
                    </div>
                    <div class="text-end">
                        <span class="text-muted small d-block">Đơn giá cao nhất</span>
                        <span class="fw-bold font-monospace" style="color: var(--accent-emerald);">@Model.GiaCaoNhat.ToString("N0") VNĐ</span>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    @if (Model.TopSanPhamGiaCao.Count == 0)
                    {
                        <div class="empty-state-card my-2 py-3">
                            <p class="empty-state-text mb-0 small">Chưa có dữ liệu sản phẩm trong kho.</p>
                        </div>
                    }
                    else
                    {
                        for (var i = 0; i < Model.TopSanPhamGiaCao.Count; i++)
                        {
                            var item = Model.TopSanPhamGiaCao[i];
                            <article class="d-flex justify-content-between align-items-center p-2 rounded border bg-white">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="rank-badge">@(i + 1)</span>
                                    <div>
                                        <p class="mb-0 fw-semibold text-dark">@item.TenSP</p>
                                        <span class="text-muted small">Mã: <span class="code-badge py-0 px-1">@item.MaSP</span></span>
                                    </div>
                                </div>
                                <span class="fw-bold font-monospace" style="color: var(--accent-emerald);">@item.DonGia.ToString("N0") VNĐ</span>
                            </article>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>
