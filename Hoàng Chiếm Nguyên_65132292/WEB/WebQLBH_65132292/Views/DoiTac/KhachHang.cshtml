@model DbQLBH_65132292.Models.ViewModels.KhachHangTraCuuViewModel

@{
    ViewData["Title"] = "Tra cuu khach hang";
    var fromPage = Math.Max(1, Model.Page - 2);
    var toPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<section class="inventory-page">
    <div class="inventory-header">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title">Tra cuu khach hang</h1>
            <p class="inventory-subtitle">Tim theo ma, ten, dien thoai, email, phuong xa, tinh.</p>
        </div>
    </div>

    <div class="inventory-card p-3 p-md-4 mb-4">
        <form method="get" asp-action="KhachHang" class="row g-3">
            <div class="col-12 col-md-9">
                <label class="form-label">Tu khoa</label>
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Nhap thong tin can tim..." />
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-12 col-md-3 d-flex align-items-end">
                <button class="inventory-add-btn w-100 justify-content-center" type="submit">Tim kiem</button>
            </div>
        </form>
    </div>

    <div class="inventory-card">
        <div class="inventory-table-wrap table-responsive">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Ma KH</th>
                        <th>Ten khach hang</th>
                        <th style="width: 140px;">Dien thoai</th>
                        <th style="width: 220px;">Email</th>
                        <th>Dia chi</th>
                        <th style="width: 200px;">Khu vuc</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.KetQua.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Khong co du lieu phu hop.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.KetQua)
                        {
                            <tr>
                                <td><span class="inventory-code">@item.MaKH</span></td>
                                <td><span class="inventory-name">@item.TenKH</span></td>
                                <td><span class="inventory-value">@item.DienThoai</span></td>
                                <td><span class="inventory-value">@item.Email</span></td>
                                <td><span class="inventory-value">@item.DiaChi</span></td>
                                <td><span class="inventory-value">@item.TenPhuongXa - @item.TenTinh</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="inventory-footer">
            <p class="inventory-stats">Trang <strong>@Model.Page</strong>/<strong>@Model.TotalPages</strong> - Tong
                <strong>@Model.TotalItems</strong> ket qua</p>
                <div class="inventory-pagination">
                    @if (Model.Page > 1)
                    {
                        <a class="inventory-page-btn" asp-action="KhachHang" asp-route-page="@(Model.Page - 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">&lt;</a>
                    }

                    @for (var i = fromPage; i <= toPage; i++)
                    {
                        <a class="inventory-page-btn @(i == Model.Page ? "active" : string.Empty)" asp-action="KhachHang"
                           asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">@i</a>
                    }

                    @if (Model.Page < Model.TotalPages)
                    {
                        <a class="inventory-page-btn" asp-action="KhachHang" asp-route-page="@(Model.Page + 1)"
                           asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">&gt;</a>
                    }
                </div>
                <a href="/doi-tac" class="btn btn-outline-secondary btn-sm">Quay ve tong quan doi tac</a>
            </div>
        </div>
    </section>
