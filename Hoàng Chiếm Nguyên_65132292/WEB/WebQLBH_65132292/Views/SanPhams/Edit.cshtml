@model DbQLBH_65132292.Models.SanPham

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>SanPham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaSP" />
            <div class="form-group">
                <label asp-for="TenSP" class="control-label"></label>
                <input asp-for="TenSP" class="form-control" />
                <span asp-validation-for="TenSP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label class="control-label">Anh hien tai</label>
                @if (!string.IsNullOrWhiteSpace(Model.AnhSP))
                {
                    <div class="mt-2">
                        <img src="@Model.AnhSP" alt="Anh san pham"
                             style="max-width: 160px; border-radius: 8px; border: 1px solid #ddd;" />
                    </div>
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="xoaAnhHienTai" name="xoaAnhHienTai"
                               value="true" />
                        <label class="form-check-label" for="xoaAnhHienTai">Xoa anh hien tai</label>
                    </div>
                }
                else
                {
                    <div class="admin-form-hint mt-2">Chua co anh san pham hien tai.</div>
                }
            </div>
            <div class="form-group">
                <label class="control-label">Tai anh moi</label>
                <input type="file" name="anhTep" class="form-control" accept=".jpg,.jpeg,.png,.webp,.gif" />
            </div>
            <div class="form-group">
                <label asp-for="DonGia" class="control-label"></label>
                <input asp-for="DonGia" class="form-control" />
                <span asp-validation-for="DonGia" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MoTaCT" class="control-label">Mo ta chi tiet</label>
                <textarea asp-for="MoTaCT" class="form-control" rows="4"></textarea>
                <div class="admin-form-hint">Nen nhap mo ta ngan gon bang tieng Viet.</div>
                <span asp-validation-for="MoTaCT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaLSP" class="control-label"></label>
                <select asp-for="MaLSP" asp-items="ViewBag.MaLSPOptions" class="form-select">
                    <option value="">-- Chon loai san pham --</option>
                </select>
                <span asp-validation-for="MaLSP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaDVT" class="control-label"></label>
                <select asp-for="MaDVT" asp-items="ViewBag.MaDVTOptions" class="form-select">
                    <option value="">-- Chon don vi tinh --</option>
                </select>
                <span asp-validation-for="MaDVT" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
