@model DbQLBH_65132292.Models.SanPham

@{
    ViewData["Title"] = "Xóa sản phẩm";
    var moTaNgan = ViewBag.MoTaNgan as string ?? "Không có mô tả";
}

<section class="inventory-page detail-page delete-page">
    <div class="inventory-header page-header page-header-split">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title page-title">Xóa sản phẩm</h1>
            <p class="inventory-subtitle page-subtitle detail-code-line">Mã sản phẩm: <span
                class="inventory-code">@Model.MaSP</span></p>
                <p class="inventory-subtitle page-subtitle">Kiểm tra lại thông tin trước khi xác nhận xóa.</p>
            </div>
            <div class="inventory-toolbar">
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
            </div>
        </div>

        <div class="inventory-card p-3 p-md-4">
            <div class="alert alert-warning mb-3" role="alert">
                Bạn có chắc chắn muốn xóa sản phẩm này không?
            </div>

            <div class="row g-4 align-items-start">
                <div class="col-12 col-lg-4">
                    <div class="detail-image-wrap">
                        @if (!string.IsNullOrWhiteSpace(Model.AnhSP))
                        {
                            <img src="@Model.AnhSP" alt="Ảnh sản phẩm" class="detail-image" />
                        }
                        else
                        {
                            <div class="detail-image-placeholder">Chưa có ảnh sản phẩm</div>
                        }
                    </div>
                </div>

                <div class="col-12 col-lg-8">
                    <dl class="row detail-meta-list mb-0">
                        <dt class="col-sm-4">Tên sản phẩm</dt>
                        <dd class="col-sm-8"><span class="inventory-name">@Model.TenSP</span></dd>

                        <dt class="col-sm-4">Đơn giá</dt>
                        <dd class="col-sm-8"><span class="inventory-value">@Model.DonGia.ToString("N0")</span></dd>

                        <dt class="col-sm-4">Mã loại</dt>
                        <dd class="col-sm-8"><span class="inventory-value">@Model.MaLSP</span></dd>

                        <dt class="col-sm-4">Mã đơn vị tính</dt>
                        <dd class="col-sm-8"><span class="inventory-value">@Model.MaDVT</span></dd>

                        <dt class="col-sm-4">Mô tả</dt>
                        <dd class="col-sm-8 detail-description">@moTaNgan</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="delete-action-row mt-4">
                <input type="hidden" asp-for="MaSP" />
                <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </form>
        </div>
    </section>
