@model IEnumerable<DbQLBH_65132292.Models.SanPham>
@using System.Globalization

@{
    ViewData["Title"] = "Quan ly San pham";
    var items = Model?.ToList() ?? new List<DbQLBH_65132292.Models.SanPham>();

    var tuKhoa = ViewBag.TuKhoa as string;
    var maNsp = ViewBag.MaNSP as short?;
    var maLsp = ViewBag.MaLSP as short?;
    var giaTu = ViewBag.GiaTu as decimal?;
    var giaDen = ViewBag.GiaDen as decimal?;
    var giaTuValue = giaTu?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;
    var giaDenValue = giaDen?.ToString(CultureInfo.InvariantCulture) ?? string.Empty;

    var currentPage = (int)(ViewBag.Page ?? 1);
    var pageSize = (int)(ViewBag.PageSize ?? 20);
    var totalItems = (int)(ViewBag.TotalItems ?? items.Count);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);

    var nhomOptions = ViewBag.NhomOptions as IEnumerable<DbQLBH_65132292.Models.NhomSP>
        ?? Enumerable.Empty<DbQLBH_65132292.Models.NhomSP>();
    var loaiOptions = ViewBag.LoaiOptions as IEnumerable<DbQLBH_65132292.Models.LoaiSP>
        ?? Enumerable.Empty<DbQLBH_65132292.Models.LoaiSP>();

    var fromPage = Math.Max(1, currentPage - 2);
    var toPage = Math.Min(totalPages, currentPage + 2);
}

<section class="inventory-page list-page">
    <div class="inventory-header page-header page-header-split">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title page-title">Quan ly San pham</h1>
            <p class="inventory-subtitle page-subtitle">Loc va phan trang tren server de xu ly tap du lieu lon.</p>
        </div>
        <div class="inventory-toolbar">
            <a asp-action="Create" class="inventory-add-btn">
                <span>Them moi</span>
            </a>
        </div>
    </div>

    <div class="inventory-card inventory-filter-card search-card p-3 p-md-4 mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-xl-end">
            <div class="col-12 col-xl-3">
                <label class="form-label">Tu khoa</label>
                <input type="text" name="tuKhoa" value="@tuKhoa" class="form-control" placeholder="MaSP, TenSP..." />
            </div>
            <div class="col-6 col-xl-2">
                <label class="form-label">Nhom SP</label>
                <select id="filter-maNsp" name="maNsp" class="form-select">
                    <option value="">Tat ca</option>
                    @foreach (var nsp in nhomOptions)
                    {
                        if (maNsp == nsp.MaNSP)
                        {
                            <option value="@nsp.MaNSP" selected>@nsp.MaNSP - @nsp.TenNSP</option>
                        }
                        else
                        {
                            <option value="@nsp.MaNSP">@nsp.MaNSP - @nsp.TenNSP</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-xl-2">
                <label class="form-label">Loai SP</label>
                <select id="filter-maLsp" name="maLsp" class="form-select">
                    <option value="">Tat ca</option>
                    @foreach (var lsp in loaiOptions)
                    {
                        if (maLsp == lsp.MaLSP)
                        {
                            <option value="@lsp.MaLSP" data-ma-nsp="@lsp.MaNSP" selected>@lsp.MaLSP - @lsp.TenLSP</option>
                        }
                        else
                        {
                            <option value="@lsp.MaLSP" data-ma-nsp="@lsp.MaNSP">@lsp.MaLSP - @lsp.TenLSP</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-xl-2">
                <label class="form-label">Muc gia</label>
                <div id="priceFilterPopover" class="inventory-price-popover neu-price-filter">
                    <button id="pricePopoverTrigger" type="button" class="inventory-price-trigger" aria-expanded="false"
                            aria-controls="pricePopoverPanel">
                        <span id="priceFilterSummary" class="inventory-price-trigger-text">Tat ca</span>
                        <span class="inventory-price-trigger-icon" aria-hidden="true">▾</span>
                    </button>

                    <fieldset id="pricePopoverPanel" class="inventory-price-filter inventory-price-panel" role="dialog"
                              aria-label="Bo loc muc gia san pham">
                        <div class="inventory-price-header">
                            <span class="inventory-price-title">Muc gia</span>
                        </div>

                        <div class="inventory-price-preset-list" role="radiogroup" aria-label="Khoang gia goi y">
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="" data-max="" />
                                <span>Tat ca</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="0" data-max="200000" />
                                <span>Duoi 200k</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="200000" data-max="500000" />
                                <span>200k - 500k</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="500000" data-max="1000000" />
                                <span>500k - 1tr</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="1000000" data-max="2000000" />
                                <span>1tr - 2tr</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="2000000" data-max="3000000" />
                                <span>2tr - 3tr</span>
                            </label>
                            <label class="inventory-price-option">
                                <input type="radio" name="pricePresetUi" data-min="3000000" data-max="" />
                                <span>Tren 3tr</span>
                            </label>
                        </div>

                        <div class="inventory-price-custom">
                            <label class="inventory-price-note" for="giaTuDisplay">Hoac nhap khoang gia tuy
                                chinh:</label>
                                <div class="inventory-price-inputs">
                                    <input id="giaTuDisplay" type="text" class="form-control inventory-price-display"
                                           inputmode="numeric" placeholder="Gia tu" autocomplete="off" />
                                    <span class="inventory-price-separator">~</span>
                                    <input id="giaDenDisplay" type="text" class="form-control inventory-price-display"
                                           inputmode="numeric" placeholder="Gia den" autocomplete="off" />
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <input id="giaTuHidden" type="hidden" name="giaTu" value="@giaTuValue" />
                    <input id="giaDenHidden" type="hidden" name="giaDen" value="@giaDenValue" />
                </div>
                <input type="hidden" name="pageSize" value="@pageSize" />
                <div class="col-12 col-xl-3 d-flex align-items-end justify-content-end gap-2 inventory-filter-actions">
                    <button type="submit" class="inventory-add-btn justify-content-center">Loc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>

        <div class="inventory-card">
            <div class="inventory-table-wrap table-responsive">
                <table class="inventory-table">
                    <thead>
                        <tr>
                            <th style="width: 140px;">Ma SP</th>
                            <th>San pham</th>
                            <th style="width: 150px;">Don gia</th>
                            <th style="width: 100px;">Ma LSP</th>
                            <th style="width: 100px;">Ma DVT</th>
                            <th style="width: 220px; text-align: right;">Thao tac</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (items.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted">Khong co du lieu phu hop.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in items)
                            {
                                <tr>
                                    <td><span class="inventory-code">@item.MaSP</span></td>
                                    <td>
                                        <span class="inventory-name">@item.TenSP</span>
                                        @if (!string.IsNullOrWhiteSpace(item.AnhSP))
                                        {
                                            <div class="text-muted small mt-1">Co anh san pham</div>
                                        }
                                    </td>
                                    <td><span class="inventory-value">@item.DonGia.ToString("N0")</span></td>
                                    <td><span class="inventory-value">@item.MaLSP</span></td>
                                    <td><span class="inventory-value">@item.MaDVT</span></td>
                                    <td>
                                        <div class="inventory-actions">
                                            <a asp-action="Details" asp-route-id="@item.MaSP" class="inventory-action"
                                               aria-label="Chi tiet" title="Chi tiet">Chi tiet</a>
                                            <a asp-action="Edit" asp-route-id="@item.MaSP" class="inventory-action" aria-label="Sua"
                                               title="Sua">Sua</a>
                                            <a asp-action="Delete" asp-route-id="@item.MaSP" class="inventory-action delete"
                                               aria-label="Xoa" title="Xoa">Xoa</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <div class="inventory-footer">
                <p class="inventory-stats">Trang <strong>@currentPage</strong>/<strong>@totalPages</strong> - Tong ban ghi:
                    <strong>@totalItems</strong>
                </p>
                <div class="inventory-pagination" aria-label="Pagination">
                    @if (currentPage > 1)
                    {
                        <a class="inventory-page-btn" asp-action="Index" asp-route-page="@(currentPage - 1)"
                           asp-route-pageSize="@pageSize" asp-route-tuKhoa="@tuKhoa" asp-route-maNsp="@maNsp"
                           asp-route-maLsp="@maLsp" asp-route-giaTu="@giaTu" asp-route-giaDen="@giaDen">&lt;</a>
                    }

                    @for (var i = fromPage; i <= toPage; i++)
                    {
                        <a class="inventory-page-btn @(i == currentPage ? "active" : string.Empty)" asp-action="Index"
                           asp-route-page="@i" asp-route-pageSize="@pageSize" asp-route-tuKhoa="@tuKhoa"
                           asp-route-maNsp="@maNsp" asp-route-maLsp="@maLsp" asp-route-giaTu="@giaTu"
                           asp-route-giaDen="@giaDen">@i</a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a class="inventory-page-btn" asp-action="Index" asp-route-page="@(currentPage + 1)"
                           asp-route-pageSize="@pageSize" asp-route-tuKhoa="@tuKhoa" asp-route-maNsp="@maNsp"
                           asp-route-maLsp="@maLsp" asp-route-giaTu="@giaTu" asp-route-giaDen="@giaDen">&gt;</a>
                    }
                </div>
            </div>
        </div>
    </section>

    @section Scripts {
        <script>
            (function () {
                const nhomSelect = document.getElementById("filter-maNsp");
                const loaiSelect = document.getElementById("filter-maLsp");
                const giaTuHidden = document.getElementById("giaTuHidden");
                const giaDenHidden = document.getElementById("giaDenHidden");
                const giaTuDisplay = document.getElementById("giaTuDisplay");
                const giaDenDisplay = document.getElementById("giaDenDisplay");
                const pricePopover = document.getElementById("priceFilterPopover");
                const pricePopoverTrigger = document.getElementById("pricePopoverTrigger");
                const pricePopoverPanel = document.getElementById("pricePopoverPanel");
                const priceFilterSummary = document.getElementById("priceFilterSummary");
                const presetRadios = Array.from(document.querySelectorAll("input[name='pricePresetUi']"));

                if (!nhomSelect || !loaiSelect) {
                    return;
                }

                const allLoaiOptions = Array.from(loaiSelect.options)
                    .filter(option => option.value !== "")
                    .map(option => ({
                        value: option.value,
                        text: option.text,
                        maNsp: option.dataset.maNsp || ""
                    }));

                function renderLoaiOptions(selectedMaNsp, selectedLoai) {
                    loaiSelect.innerHTML = "";

                    const defaultOption = document.createElement("option");
                    defaultOption.value = "";
                    defaultOption.text = "Tat ca";
                    loaiSelect.appendChild(defaultOption);

                    allLoaiOptions
                        .filter(item => !selectedMaNsp || item.maNsp === selectedMaNsp)
                        .forEach(item => {
                            const option = document.createElement("option");
                            option.value = item.value;
                            option.text = item.text;
                            option.dataset.maNsp = item.maNsp;
                            loaiSelect.appendChild(option);
                        });

                    if (selectedLoai && Array.from(loaiSelect.options).some(option => option.value === selectedLoai)) {
                        loaiSelect.value = selectedLoai;
                    } else {
                        loaiSelect.value = "";
                    }
                }

                const initialLoai = loaiSelect.value;
                renderLoaiOptions(nhomSelect.value, initialLoai);

                nhomSelect.addEventListener("change", () => {
                    renderLoaiOptions(nhomSelect.value, loaiSelect.value);
                });

                function toDigits(value) {
                    return (value || "").replace(/\D/g, "");
                }

                function formatMoney(value) {
                    if (!value) {
                        return "";
                    }

                    const number = Number(value);
                    if (Number.isNaN(number)) {
                        return "";
                    }

                    return `${number.toLocaleString("vi-VN")}d`;
                }

                function syncDisplayFromHidden() {
                    if (!giaTuHidden || !giaDenHidden || !giaTuDisplay || !giaDenDisplay) {
                        return;
                    }

                    giaTuDisplay.value = formatMoney(giaTuHidden.value);
                    giaDenDisplay.value = formatMoney(giaDenHidden.value);
                }

                function syncHiddenFromDisplay(clearPreset) {
                    if (!giaTuHidden || !giaDenHidden || !giaTuDisplay || !giaDenDisplay) {
                        return;
                    }

                    giaTuHidden.value = toDigits(giaTuDisplay.value);
                    giaDenHidden.value = toDigits(giaDenDisplay.value);

                    if (clearPreset) {
                        presetRadios.forEach(radio => {
                            radio.checked = false;
                        });
                    }
                }

                function syncPresetFromHidden() {
                    const minValue = (giaTuHidden?.value || "").trim();
                    const maxValue = (giaDenHidden?.value || "").trim();

                    let matched = false;
                    presetRadios.forEach(radio => {
                        const radioMin = (radio.dataset.min || "").trim();
                        const radioMax = (radio.dataset.max || "").trim();
                        const isMatch = radioMin === minValue && radioMax === maxValue;
                        radio.checked = isMatch;
                        matched = matched || isMatch;
                    });

                    if (!matched) {
                        presetRadios.forEach(radio => {
                            radio.checked = false;
                        });
                    }
                }

                function getSelectedPresetLabel() {
                    const activeRadio = presetRadios.find(radio => radio.checked);
                    if (!activeRadio) {
                        return "";
                    }

                    const labelNode = activeRadio.closest("label");
                    return labelNode ? (labelNode.innerText || "").trim() : "";
                }

                function updatePriceSummary() {
                    if (!priceFilterSummary) {
                        return;
                    }

                    const presetLabel = getSelectedPresetLabel();
                    if (presetLabel) {
                        priceFilterSummary.textContent = presetLabel;
                        return;
                    }

                    const minValue = (giaTuHidden?.value || "").trim();
                    const maxValue = (giaDenHidden?.value || "").trim();

                    if (!minValue && !maxValue) {
                        priceFilterSummary.textContent = "Tat ca";
                        return;
                    }

                    if (minValue && maxValue) {
                        priceFilterSummary.textContent = `${formatMoney(minValue)} - ${formatMoney(maxValue)}`;
                        return;
                    }

                    if (minValue) {
                        priceFilterSummary.textContent = `Tu ${formatMoney(minValue)}`;
                        return;
                    }

                    priceFilterSummary.textContent = `Den ${formatMoney(maxValue)}`;
                }

                function setPopoverOpen(isOpen) {
                    if (!pricePopover || !pricePopoverTrigger) {
                        return;
                    }

                    pricePopover.classList.toggle("is-open", isOpen);
                    pricePopoverTrigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
                }

                function setupPricePopover() {
                    if (!pricePopover || !pricePopoverTrigger || !pricePopoverPanel) {
                        return;
                    }

                    pricePopoverTrigger.addEventListener("click", event => {
                        event.preventDefault();
                        const willOpen = !pricePopover.classList.contains("is-open");
                        setPopoverOpen(willOpen);
                    });

                    document.addEventListener("click", event => {
                        const target = event.target;
                        if (!(target instanceof Node)) {
                            return;
                        }

                        if (!pricePopover.contains(target)) {
                            setPopoverOpen(false);
                        }
                    });

                    document.addEventListener("keydown", event => {
                        if (event.key === "Escape") {
                            setPopoverOpen(false);
                        }
                    });
                }

                if (giaTuHidden && giaDenHidden && giaTuDisplay && giaDenDisplay) {
                    syncDisplayFromHidden();
                    syncPresetFromHidden();
                    updatePriceSummary();
                    setupPricePopover();

                    presetRadios.forEach(radio => {
                        radio.addEventListener("change", () => {
                            if (!radio.checked) {
                                return;
                            }

                            giaTuHidden.value = (radio.dataset.min || "").trim();
                            giaDenHidden.value = (radio.dataset.max || "").trim();
                            syncDisplayFromHidden();
                            updatePriceSummary();
                            setPopoverOpen(false);
                        });
                    });

                    giaTuDisplay.addEventListener("input", () => {
                        syncHiddenFromDisplay(true);
                        updatePriceSummary();
                    });

                    giaDenDisplay.addEventListener("input", () => {
                        syncHiddenFromDisplay(true);
                        updatePriceSummary();
                    });

                    giaTuDisplay.addEventListener("blur", () => {
                        syncHiddenFromDisplay(true);
                        syncDisplayFromHidden();
                        updatePriceSummary();
                    });

                    giaDenDisplay.addEventListener("blur", () => {
                        syncHiddenFromDisplay(true);
                        syncDisplayFromHidden();
                        updatePriceSummary();
                    });
                }
            })();
        </script>
    }
