@model DbQLBH_65132292.Models.KhachHang

@{
    ViewData["Title"] = "Chỉnh sửa khách hàng";
    var maTinh = ViewBag.MaTinh as string;
}

<h1 class="page-title h4 mb-1">Chỉnh sửa thông tin khách hàng</h1>
<hr />
<div class="row">
    <div class="col-md-7 col-lg-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaKH" />
            <div class="mb-3">
                <label asp-for="TenKH" class="form-label"></label>
                <input asp-for="TenKH" class="form-control" />
                <span asp-validation-for="TenKH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DienThoai" class="form-label"></label>
                <input asp-for="DienThoai" class="form-control" />
                <span asp-validation-for="DienThoai" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DiaChi" class="form-label"></label>
                <input asp-for="DiaChi" class="form-control" />
                <p class="admin-form-hint">Nhập địa chỉ ngắn gọn, dễ đọc. Không dán payload/mẫu JSON.</p>
                <span asp-validation-for="DiaChi" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Tỉnh / Thành phố</label>
                <select id="maTinh" name="maTinh" class="form-select" asp-items="ViewBag.TinhOptions">
                    <option value="">-- Chọn Tỉnh/Thành phố --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="MaPX" class="form-label">Phường/Xã</label>
                <select asp-for="MaPX" id="maPX" class="form-select" asp-items="ViewBag.PhuongXaOptions">
                    <option value="">-- Chọn Phường/Xã --</option>
                </select>
                <span asp-validation-for="MaPX" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const tinhSelect = document.getElementById("maTinh");
            const phuongXaSelect = document.getElementById("maPX");
            const selectedTinh = "@maTinh";
            const selectedPhuongXa = "@Model.MaPX";
            const getPhuongXaUrl = '@Url.Action("GetPhuongXa", "KhachHangs")';

            async function loadPhuongXa(maTinh, selectedValue) {
                phuongXaSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                if (!maTinh) {
                    return;
                }

                const response = await fetch(`${getPhuongXaUrl}?maTinh=${encodeURIComponent(maTinh)}`);
                if (!response.ok) {
                    return;
                }

                const items = await response.json();
                items.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.maPX;
                    option.textContent = `${item.maPX} - ${item.tenPX}`;
                    if (selectedValue && selectedValue === item.maPX) {
                        option.selected = true;
                    }
                    phuongXaSelect.appendChild(option);
                });
            }

            tinhSelect.addEventListener("change", () => loadPhuongXa(tinhSelect.value, null));
            if (selectedTinh) {
                tinhSelect.value = selectedTinh;
                loadPhuongXa(selectedTinh, selectedPhuongXa);
            }
        })();
    </script>
}
