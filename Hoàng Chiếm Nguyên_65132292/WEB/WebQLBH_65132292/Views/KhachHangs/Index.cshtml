@model DbQLBH_65132292.Models.ViewModels.KhachHangIndexViewModel

@{
    ViewData["Title"] = "Khách hàng";
    var fromPage = Math.Max(1, Model.Page - 2);
    var toPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<section class="inventory-page list-page">
    <div class="inventory-header page-header page-header-split">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title page-title">Quản lý Khách hàng</h1>
            <p class="inventory-subtitle page-subtitle">Quản lý danh sách khách hàng với tìm kiếm và phân trang.</p>
        </div>
        <div class="inventory-toolbar">
            <a asp-action="Create" class="inventory-add-btn">Thêm khách hàng mới</a>
        </div>
    </div>

    <div class="inventory-card inventory-filter-card search-card mb-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-8 col-xl-9">
                <label class="form-label" for="tuKhoaKh">Từ khóa</label>
                <div class="inventory-search-wrap">
                    <i class="bi bi-search inventory-search-icon" aria-hidden="true"></i>
                    <input id="tuKhoaKh" type="text" name="tuKhoa" value="@Model.TuKhoa" class="inventory-search"
                           placeholder="Mã, tên, số điện thoại, email..." />
                </div>
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-12 col-md-4 col-xl-3 d-flex gap-2 align-items-end">
                <button type="submit" class="inventory-add-btn flex-fill justify-content-center">Lọc</button>
                <a asp-action="Index" class="btn btn-outline-secondary flex-fill text-center">Đặt lại</a>
            </div>
        </form>
    </div>

    <div class="inventory-card">
        <div class="inventory-table-wrap table-responsive">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th style="width: 120px;">Mã KH</th>
                        <th>Tên khách hàng</th>
                        <th style="width: 140px;">Điện thoại</th>
                        <th style="width: 220px;">Email</th>
                        <th>Khu vực</th>
                        <th style="width: 240px; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Không có dữ liệu khách hàng.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td><span class="inventory-code">@item.MaKH</span></td>
                                <td>
                                    <div class="inventory-name">@item.TenKH</div>
                                    <div class="text-muted small">@item.DiaChi</div>
                                </td>
                                <td><span class="inventory-value">@item.DienThoai</span></td>
                                <td><span class="inventory-value">@item.Email</span></td>
                                <td><span class="inventory-value">@item.TenPX - @item.TenTinh</span></td>
                                <td class="text-end">
                                    <div class="inventory-actions">
                                        <a asp-action="Details" asp-route-id="@item.MaKH" class="inventory-action">Chi tiết</a>
                                        <a asp-action="Edit" asp-route-id="@item.MaKH" class="inventory-action">Sửa</a>
                                        <a asp-action="Delete" asp-route-id="@item.MaKH" class="inventory-action delete">Xóa</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="inventory-footer">
            <p class="inventory-stats">Trang <strong>@Model.Page</strong>/<strong>@Model.TotalPages</strong> — Tổng cộng
                <strong>@Model.TotalItems</strong> khách hàng
            </p>
            <div class="inventory-pagination">
                @if (Model.Page > 1)
                {
                    <a class="inventory-page-btn" asp-action="Index" asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">&lt;</a>
                }

                @for (var i = fromPage; i <= toPage; i++)
                {
                    <a class="inventory-page-btn @(i == Model.Page ? "active" : string.Empty)" asp-action="Index"
                       asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">@i</a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a class="inventory-page-btn" asp-action="Index" asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa">&gt;</a>
                }
            </div>
        </div>
    </div>
</section>
