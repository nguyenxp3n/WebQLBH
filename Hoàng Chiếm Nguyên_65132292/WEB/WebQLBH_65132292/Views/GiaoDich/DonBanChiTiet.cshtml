@model DbQLBH_65132292.Models.ViewModels.DonBanChiTietViewModel

@{
    ViewData["Title"] = "Chi tiết đơn bán";
}

<section class="inventory-page">
    <div class="inventory-header d-flex justify-content-between align-items-center mb-4">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title h4 mb-1">Chi tiết đơn bán hàng @Model.MaDBH</h1>
            <p class="inventory-subtitle text-muted mb-0">
                Khách hàng: <strong>@Model.TenKH</strong> (Mã KH: <span class="code-badge py-0 px-1">@Model.MaKH</span>) — Ngày xuất bán: <strong>@Model.NgayBan.ToString("dd/MM/yyyy")</strong>
            </p>
            <p class="inventory-subtitle text-muted small mt-1">Địa chỉ giao hàng: @Model.DiaChiGiaoHang</p>
        </div>
        <div class="inventory-toolbar">
            <a class="btn btn-outline-secondary" href="/giao-dich/don-ban">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
        </div>
    </div>

    <div class="inventory-card">
        <div class="inventory-table-wrap table-responsive">
            <table class="inventory-table table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 140px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th style="width: 120px;" class="text-center">Số lượng</th>
                        <th style="width: 170px;" class="text-end">Đơn giá bán</th>
                        <th style="width: 180px;" class="text-end">Thành tiền (VNĐ)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ChiTiet.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state-card my-3 py-4">
                                    <i class="bi bi-box-seam empty-state-icon mb-2"></i>
                                    <p class="empty-state-title mb-1">Chưa có mặt hàng chi tiết</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.ChiTiet)
                        {
                            <tr>
                                <td><span class="code-badge">@item.MaSP</span></td>
                                <td class="fw-semibold text-dark">@item.TenSP</td>
                                <td class="text-center"><span class="badge-status badge-new font-monospace">@item.SoLuong</span></td>
                                <td class="text-end"><span class="font-monospace text-secondary">@item.DonGiaBan.ToString("N0")</span></td>
                                <td class="text-end"><span class="font-monospace fw-semibold" style="color: var(--accent-emerald);">@item.ThanhTien.ToString("N0")</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="inventory-footer d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
            <p class="inventory-stats text-muted mb-0">Tổng giá trị đơn bán: <strong class="font-monospace h5 mb-0" style="color: var(--accent-emerald);">@Model.TongTien.ToString("N0") VNĐ</strong></p>
            <a class="btn btn-sm btn-outline-secondary" href="/xuat-du-lieu/don-ban-csv">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất CSV đơn bán
            </a>
        </div>
    </div>
</section>
