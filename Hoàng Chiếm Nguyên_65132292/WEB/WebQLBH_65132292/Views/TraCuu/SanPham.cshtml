@model DbQLBH_65132292.Models.TraCuuSanPhamViewModel

@{
    ViewData["Title"] = "Tra cứu sản phẩm";
    var fromPage = Math.Max(1, Model.Page - 2);
    var toPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<section class="inventory-page tra-cuu-page">
    <div class="inventory-header d-flex justify-content-between align-items-center mb-4">
        <div class="inventory-title-wrap">
            <h1 class="inventory-title h4 mb-1">Tra cứu sản phẩm</h1>
            <p class="inventory-subtitle text-muted mb-0">Lọc theo nhóm, loại, khoảng giá và từ khóa tìm kiếm nhanh.</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary" href="/xuat-du-lieu/san-pham-csv">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Xuất CSV danh mục
            </a>
        </div>
    </div>

    <div class="inventory-card tra-cuu-filter-card mb-4">
        <form method="get" asp-action="SanPham" class="row g-3 p-3 p-md-4">
            <div class="col-12 col-md-6 col-xl-3">
                <label class="form-label">Từ khóa tìm kiếm</label>
                <input type="text" name="tuKhoa" value="@Model.TuKhoa" class="form-control"
                       placeholder="Mã sản phẩm, tên sản phẩm..." />
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="form-label">Nhóm sản phẩm</label>
                <select name="maNsp" class="form-select">
                    <option value="">Tất cả nhóm</option>
                    @foreach (var item in Model.DanhSachNhom)
                    {
                        if (Model.MaNSP == item.MaNSP)
                        {
                            <option value="@item.MaNSP" selected>@item.MaNSP - @item.TenNSP</option>
                        }
                        else
                        {
                            <option value="@item.MaNSP">@item.MaNSP - @item.TenNSP</option>
                        }
                    }
                </select>
            </div>
            <div class="col-12 col-md-6 col-xl-2">
                <label class="form-label">Loại sản phẩm</label>
                <select name="maLsp" class="form-select">
                    <option value="">Tất cả loại</option>
                    @foreach (var item in Model.DanhSachLoai)
                    {
                        if (Model.MaLSP == item.MaLSP)
                        {
                            <option value="@item.MaLSP" selected>@item.MaLSP - @item.TenLSP</option>
                        }
                        else
                        {
                            <option value="@item.MaLSP">@item.MaLSP - @item.TenLSP</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label">Giá từ</label>
                <input type="number" name="giaTu" value="@Model.GiaTu" class="form-control" min="0" step="1000" placeholder="0" />
            </div>
            <div class="col-6 col-md-3 col-xl-1">
                <label class="form-label">Giá đến</label>
                <input type="number" name="giaDen" value="@Model.GiaDen" class="form-control" min="0" step="1000" placeholder="Tối đa" />
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-6 col-md-3 col-xl-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-funnel me-1"></i>Lọc</button>
            </div>
            <div class="col-6 col-md-3 col-xl-1 d-flex align-items-end">
                <a asp-action="SanPham" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-counterclockwise me-1"></i>Xóa</a>
            </div>
        </form>
    </div>

    <div class="inventory-card">
        <div class="inventory-table-wrap table-responsive">
            <table class="inventory-table table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 140px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th style="width: 170px;" class="text-end">Đơn giá</th>
                        <th style="width: 180px;">Loại sản phẩm</th>
                        <th style="width: 200px;">Nhóm sản phẩm</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.KetQua.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state-card my-3 py-4">
                                    <i class="bi bi-search empty-state-icon mb-2"></i>
                                    <p class="empty-state-title mb-1">Không tìm thấy sản phẩm phù hợp</p>
                                    <p class="empty-state-text mb-0 small">Vui lòng thử điều chỉnh lại từ khóa hoặc nới rộng khoảng giá lọc.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model.KetQua)
                        {
                            <tr>
                                <td><span class="code-badge">@item.MaSP</span></td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.TenSP</div>
                                    <div class="text-muted small">@item.TenLSP</div>
                                </td>
                                <td class="text-end"><span class="font-monospace fw-semibold" style="color: var(--accent-emerald);">@item.DonGia.ToString("N0") VNĐ</span></td>
                                <td><span class="badge-status badge-new">@item.TenLSP</span></td>
                                <td><span class="text-secondary small">@item.TenNSP</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="inventory-footer d-flex flex-wrap justify-content-between align-items-center p-3 border-top">
            <p class="inventory-stats text-muted mb-0 small">Trang <strong>@Model.Page</strong>/<strong>@Model.TotalPages</strong> — Tổng cộng <strong>@Model.TotalItems</strong> sản phẩm</p>
            <div class="inventory-pagination d-flex gap-1">
                @if (Model.Page > 1)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="SanPham" asp-route-page="@(Model.Page - 1)"
                       asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa" asp-route-maNsp="@Model.MaNSP"
                       asp-route-maLsp="@Model.MaLSP" asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen">&laquo;</a>
                }

                @for (var i = fromPage; i <= toPage; i++)
                {
                    <a class="btn btn-sm @(i == Model.Page ? "btn-primary" : "btn-outline-secondary")" asp-action="SanPham"
                       asp-route-page="@i" asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa"
                       asp-route-maNsp="@Model.MaNSP" asp-route-maLsp="@Model.MaLSP" asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen">@i</a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="SanPham" asp-route-page="@(Model.Page + 1)"
                       asp-route-pageSize="@Model.PageSize" asp-route-tuKhoa="@Model.TuKhoa" asp-route-maNsp="@Model.MaNSP"
                       asp-route-maLsp="@Model.MaLSP" asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen">&raquo;</a>
                }
            </div>
        </div>
    </div>
</section>
