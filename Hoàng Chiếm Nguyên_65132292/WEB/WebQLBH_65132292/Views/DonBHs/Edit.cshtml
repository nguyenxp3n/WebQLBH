@model DbQLBH_65132292.Models.DonBH

@{
    ViewData["Title"] = "Sửa đơn bán";
    var maTinh = ViewBag.MaTinh as string;
}

<h1 class="page-title">Sửa đơn bán</h1>
<hr />
<div class="row">
    <div class="col-md-7 col-lg-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="MaDBH" />
            <div class="mb-3">
                <label asp-for="NgayBan" class="form-label"></label>
                <input asp-for="NgayBan" type="date" class="form-control" />
                <span asp-validation-for="NgayBan" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="MaKH" class="form-label">Khách hàng</label>
                <select asp-for="MaKH" class="form-select" asp-items="ViewBag.KhachHangOptions">
                    <option value="">-- Chọn khách hàng --</option>
                </select>
                <span asp-validation-for="MaKH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="DCGH" class="form-label"></label>
                <input asp-for="DCGH" class="form-control" />
                <p class="admin-form-hint">Nhập địa chỉ giao hàng ngắn gọn, dễ đọc. Không dán payload/mẫu JSON.</p>
                <span asp-validation-for="DCGH" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Tỉnh giao hàng</label>
                <select id="maTinh" name="maTinh" class="form-select" asp-items="ViewBag.TinhOptions">
                    <option value="">-- Chọn Tỉnh/Thành phố --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="MaPX" class="form-label">Phường/Xã giao hàng</label>
                <select asp-for="MaPX" id="maPX" class="form-select" asp-items="ViewBag.PhuongXaOptions">
                    <option value="">-- Chọn Phường/Xã --</option>
                </select>
                <span asp-validation-for="MaPX" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
            <a asp-action="Details" asp-route-id="@Model.MaDBH" class="btn btn-outline-secondary ms-2">Quay lại</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const tinhSelect = document.getElementById("maTinh");
            const phuongXaSelect = document.getElementById("maPX");
            const selectedTinh = "@maTinh";
            const selectedPhuongXa = "@Model.MaPX";
            const getPhuongXaUrl = '@Url.Action("GetPhuongXa", "DonBHs")';

            async function loadPhuongXa(maTinh, selectedValue) {
                phuongXaSelect.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                if (!maTinh) {
                    return;
                }

                const response = await fetch(`${getPhuongXaUrl}?maTinh=${encodeURIComponent(maTinh)}`);
                if (!response.ok) {
                    return;
                }

                const items = await response.json();
                items.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.maPX;
                    option.textContent = `${item.maPX} - ${item.tenPX}`;
                    if (selectedValue && selectedValue === item.maPX) {
                        option.selected = true;
                    }
                    phuongXaSelect.appendChild(option);
                });
            }

            tinhSelect.addEventListener("change", () => loadPhuongXa(tinhSelect.value, null));
            if (selectedTinh) {
                tinhSelect.value = selectedTinh;
                loadPhuongXa(selectedTinh, selectedPhuongXa);
            }
        })();
    </script>
}
