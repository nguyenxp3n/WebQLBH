@model DbQLBH_65132292.Models.DonBH

@{
    ViewData["Title"] = "Tao don ban";
}

<section class="admin-form-page">
    <div class="page-header page-header-split">
        <div class="page-title-group">
            <span class="icon-chip" aria-hidden="true"><i class="bi bi-receipt"></i></span>
            <div>
                <h1 class="page-title">Tao don ban moi</h1>
                <p class="page-subtitle">Nhap thong tin header don ban truoc khi them dong san pham.</p>
            </div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lai danh sach</a>
    </div>

    <div class="app-card admin-form-card">
        <form asp-action="Create" method="post" class="row g-3 admin-form-grid">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

            <div class="col-12 col-lg-4">
                <label asp-for="MaDBH" class="control-label"></label>
                <input asp-for="MaDBH" class="form-control" />
                <span asp-validation-for="MaDBH" class="text-danger"></span>
            </div>

            <div class="col-12 col-lg-4">
                <label asp-for="NgayBan" class="control-label"></label>
                <input asp-for="NgayBan" type="date" class="form-control" />
                <span asp-validation-for="NgayBan" class="text-danger"></span>
            </div>

            <div class="col-12 col-lg-4">
                <label asp-for="MaKH" class="control-label">Khach hang</label>
                <select asp-for="MaKH" class="form-select" asp-items="ViewBag.KhachHangOptions">
                    <option value="">-- Chon khach hang --</option>
                </select>
                <span asp-validation-for="MaKH" class="text-danger"></span>
            </div>

            <div class="col-12 col-lg-6">
                <label asp-for="DCGH" class="control-label"></label>
                <input asp-for="DCGH" class="form-control" />
                <p class="admin-form-hint">Nhap dia chi giao hang ngan gon, de doc. Khong dan payload/mau JSON.</p>
                <span asp-validation-for="DCGH" class="text-danger"></span>
            </div>

            <div class="col-12 col-lg-3">
                <label class="control-label">Tinh giao hang</label>
                <select id="maTinh" name="maTinh" class="form-select" asp-items="ViewBag.TinhOptions">
                    <option value="">-- Chon tinh --</option>
                </select>
            </div>

            <div class="col-12 col-lg-3">
                <label asp-for="MaPX" class="control-label">Phuong xa giao hang</label>
                <select asp-for="MaPX" id="maPX" class="form-select" asp-items="ViewBag.PhuongXaOptions">
                    <option value="">-- Chon phuong xa --</option>
                </select>
                <span asp-validation-for="MaPX" class="text-danger"></span>
            </div>

            <div class="col-12 admin-form-actions">
                <a asp-action="Index" class="btn btn-outline-secondary">Huy</a>
                <button type="submit" class="primary-btn">Tao don</button>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const tinhSelect = document.getElementById("maTinh");
            const phuongXaSelect = document.getElementById("maPX");
            const getPhuongXaUrl = '@Url.Action("GetPhuongXa", "DonBHs")';

            async function loadPhuongXa(maTinh, selectedValue) {
                phuongXaSelect.innerHTML = '<option value="">-- Chon phuong xa --</option>';
                if (!maTinh) {
                    return;
                }

                const response = await fetch(`${getPhuongXaUrl}?maTinh=${encodeURIComponent(maTinh)}`);
                if (!response.ok) {
                    return;
                }

                const items = await response.json();
                items.forEach(item => {
                    const option = document.createElement("option");
                    option.value = item.maPX;
                    option.textContent = `${item.maPX} - ${item.tenPX}`;
                    if (selectedValue && selectedValue === item.maPX) {
                        option.selected = true;
                    }
                    phuongXaSelect.appendChild(option);
                });
            }

            tinhSelect.addEventListener("change", () => loadPhuongXa(tinhSelect.value, null));
        })();
    </script>
}
