@model DbQLBH_65132292.Models.NhaCC

@{
    ViewData["Title"] = "Xóa nhà cung cấp";
}

<h1 class="page-title h4 mb-1">Xóa nhà cung cấp</h1>
<h3>Bạn có chắc chắn muốn xóa nhà cung cấp này không?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Mã NCC</dt>
        <dd class="col-sm-9">@Model.MaNCC</dd>
        <dt class="col-sm-3">Tên nhà cung cấp</dt>
        <dd class="col-sm-9">@Model.TenNCC</dd>
        <dt class="col-sm-3">Điện thoại</dt>
        <dd class="col-sm-9">@Model.DienThoai</dd>
        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>
        <dt class="col-sm-3">Địa chỉ</dt>
        <dd class="col-sm-9">@(ViewBag.DiaChiAnToan ?? Model.DiaChi)</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="MaNCC" />
        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Hủy</a>
    </form>
</div>
